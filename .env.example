# Neon - connection string del endpoint POOLED (el host lleva "-pooler").
# Dashboard de Neon -> boton "Connect".
# Neon la da con "&channel_binding=require" al final: lib/db/index.ts lo saca
# solo, pero si lo ves en el panel de Vercel podes borrarlo.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Conexion DIRECTA (el mismo host sin "-pooler"). Solo la usa drizzle-kit.
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar las cookies de sesion. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# PIN inicial del usuario admin que crea el seed (usuario: admin)
ADMIN_PIN="1234"

# Clave para que Vercel Cron pueda llamar a /api/cron/cotizacion (el dólar
# automático). Cualquier texto largo al azar; Vercel la manda sola.
CRON_SECRET="otra-clave-larga-y-aleatoria"
